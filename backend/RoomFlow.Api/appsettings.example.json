{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=RoomFlow;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Issuer",
    "Audience": "Audience",
    "SigningKey": "REPLACE_WITH_A_SECRET_AT_LEAST_32_BYTES",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationHours": 24
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "AuthCookie": {
    "Secure": false,
    "SameSite": "Lax"
  },
  "HttpsRedirection": false,
  "APPLY_MIGRATIONS": false,
  "ENABLE_SWAGGER": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
